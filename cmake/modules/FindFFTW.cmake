# FFTW_INCLUDE_DIR = fftw3.h
# FFTW_LIBRARIES = libfftw3f.a libfftw3.a
# FFTW_FOUND = true if FFTW3 is found

IF(FFTW_INCLUDE_DIRS)
  FIND_PATH(FFTW_INCLUDE_DIR fftw3.h ${FFTW_INCLUDE_DIRS})
  FIND_LIBRARY(FFTW_LIB_DOUBLE NAMES fftw3 ${FFTW_LIBRARY_DIRS})
  FIND_LIBRARY(FFTW_LIB_FLOAT NAMES fftw3f ${FFTW_LIBRARY_DIRS})
ELSE(FFTW_INCLUDE_DIRS)
  FIND_PATH(FFTW_INCLUDE_DIR fftw3.h ${QMC_INCLUDE_PATHS})
  FIND_LIBRARY(FFTW_LIB_DOUBLE NAMES fftw3 ${QMC_LIBRARY_PATHS})
  FIND_LIBRARY(FFTW_LIB_FLOAT NAMES fftw3f ${QMC_LIBRARY_PATHS})
ENDIF(FFTW_INCLUDE_DIRS)

IF(FFTW_LIB_FLOAT AND FFTW_LIB_DOUBLE)
  SET(FFTW_LIBRARIES ${FFTW_LIB_FLOAT} ${FFTW_LIB_DOUBLE})
ELSEIF(FFTW_LIB_FLOAT)
  SET(FFTW_LIBRARIES ${FFTW_LIB_FLOAT})
ELSEIF(FFTW_LIB_DOUBLE)
  SET(FFTW_LIBRARIES ${FFTW_LIB_DOUBLE})
ENDIF()
SET(FFTW_LIBRARY ${FFTW_LIBRARIES})

SET(FFTW_FOUND FALSE)
IF(FFTW_INCLUDE_DIR AND FFTW_LIBRARIES)
  MESSAGE(STATUS "FFTW_INCLUDE_DIR=${FFTW_INCLUDE_DIR}")
  MESSAGE(STATUS "FFTW_LIBRARIES=${FFTW_LIBRARIES}")
  SET(FFTW_FOUND TRUE)
ENDIF()

MARK_AS_ADVANCED(
   FFTW_INCLUDE_DIR
   FFTW_LIBRARIES
   FFTW_FOUND
)
